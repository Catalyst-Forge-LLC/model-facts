{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "model-facts",
  "compatibility_date": "2026-07-31",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // HTML folders get a trailing slash. Do not add a Pages-style
    // /directory/:slug _redirects rule — it also matches directory.css,
    // listing.js, and index.json and 301s them to 404s.
    "html_handling": "auto-trailing-slash"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
